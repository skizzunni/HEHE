# Python bytecode -- regenerated on every import, never source
__pycache__/
*.py[cod]

# Local scratch data pulls (schedules, odds, game logs)
*.json
!package.json

# The pick record is not scratch data. It is the only thing in this repo that
# cannot be refetched -- a graded call is gone the moment the container is
# reclaimed -- so it is tracked.
!ledger.json
# Every stack leg and ticket, graded -- same reason.
!stacks.json
# Every recommended prop and how it settled -- prop prices vanish after the game.
!props.json
# Every day's locks and how they settled.
!locks.json
# graded lottery tickets
!lottery.json
# Every live Kalshi trade the bot made through a quote -- not refetchable.
!bot_trades.json

# The ESPN day-cache is 500MB+ of refetchable scratch and never ships.
data/espn_cache/

# The match history is derived, but rebuilding it costs ~490 ESPN requests and
# the board cannot compute a rating without it, so it ships like ledger.json.
!data/matches_2026.json
# Backtest results; stacks.py reads its per-sport haircut from them.
!data/backtest_stacks.json
!data/backtest_kalshi.json
# the lottery replay; lottery.py reads its price-band returns
!data/backtest_lottery.json
# the daily review: every day's results and the weights it refits
!review/*.json
!data/edge_lab.json
!data/soccer_lab.json
!data/totals_lab.json
!data/nhl_lab.json
!data/ladder_lab.json
!data/ufc_lab.json
!data/td_lab.json
!data/td_history.json
!data/ladder_history.json
!data/weather_lab.json
!data/backtest_kalshi_legs.json
!data/paired_eval.json
!data/whole_ticket.json
!data/devig_study.json
!data/calibration_study.json
